# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-side only — never exposed to the browser
SUPABASE_SECRET_KEY=your_supabase_secret_key
# DeepSeek — chat, presentations, and web-project fallback
DEEPSEEK_API_KEY=your_deepseek_api_key
# Manus agent (optional) — preferred builder for websites, games, and apps
MANUS_API_KEY=

# ---------------------------------------------------------------------------
# Custom domains (all optional — the app runs without them; domain purchase
# shows "not configured" until the keys below are set)
# ---------------------------------------------------------------------------

# The hostname this app is served from, e.g. studio.example.com.
# Middleware uses it to tell app traffic apart from customer domains.
NEXT_PUBLIC_APP_HOST=

# Porkbun — domain availability, registration, and DNS
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Stripe — domain checkout. Point a webhook at /api/domains/webhook with the
# checkout.session.completed event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel — attach customer domains to this project so TLS works
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
